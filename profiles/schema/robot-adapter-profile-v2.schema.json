{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://xgc2.dev/schemas/robot-adapter-profile-v2.schema.json",
  "title": "XGC2 Robot Adapter Profile v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile_id",
    "profile_version",
    "native_protocol",
    "robot_kind",
    "parameters",
    "semantic_traits",
    "channels"
  ],
  "properties": {
    "schema": {
      "const": "xgc.robot.adapter-profile/v2"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*\\.v[1-9][0-9]*$"
    },
    "profile_version": {
      "type": "integer",
      "minimum": 1
    },
    "native_protocol": {
      "type": "string",
      "enum": ["ros1"]
    },
    "robot_kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "parameters": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "properties": {
        "mocap_rigid_body": {
          "allOf": [
            {"$ref": "#/definitions/parameter"},
            {
              "required": ["pattern"],
              "properties": {
                "pattern": {"const": "^[A-Za-z][A-Za-z0-9_]*$"}
              }
            }
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/definitions/parameter"
      }
    },
    "semantic_traits": {
      "$ref": "#/definitions/semanticTraits"
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/channel"
      }
    }
  },
  "definitions": {
    "semanticCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel_id", "maximum_age_ms"],
      "properties": {
        "channel_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "maximum_age_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "predicate": {
          "type": "string",
          "enum": [
            "xgc.semantic.aerial.flight.connected",
            "xgc.semantic.common.vehicle-health.online"
          ]
        }
      }
    },
    "semanticTraits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_stale_after_ms",
        "channel_stale_after_ms",
        "online_conditions",
        "operational_ready_conditions"
      ],
      "properties": {
        "default_stale_after_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "channel_stale_after_ms": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          }
        },
        "online_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/semanticCondition"}
        },
        "operational_ready_conditions": {
          "type": "array",
          "items": {"$ref": "#/definitions/semanticCondition"}
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "required", "description"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["string", "integer", "number", "boolean"]
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "pattern": {
          "type": "string",
          "minLength": 3,
          "maxLength": 256
        }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:[a-zA-Z][a-zA-Z0-9_]*|\\{[a-z][a-z0-9_]*\\})(?:/(?:[a-zA-Z][a-zA-Z0-9_]*|\\{[a-z][a-z0-9_]*\\}))*$"
        },
        "type": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]*/[a-zA-Z][a-zA-Z0-9_]*$"
        },
        "scope": {
          "type": "string",
          "enum": ["robot_namespace", "global"]
        }
      }
    },
    "policyValue": {
      "anyOf": [
        {"type": "string"},
        {"type": "number"},
        {"type": "integer"},
        {"type": "boolean"},
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "operationContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "side_effect",
        "idempotency",
        "cancellation_supported",
        "deadline_required"
      ],
      "properties": {
        "side_effect": {
          "type": "string",
          "enum": ["read-only", "idempotent", "non-idempotent"]
        },
        "idempotency": {
          "const": "required"
        },
        "cancellation_supported": {
          "const": false
        },
        "deadline_required": {
          "const": true
        }
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "processor"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "kind": {
          "type": "string",
          "enum": ["stream_out", "operation"]
        },
        "processor": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9_]+)*$"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "operation_contract": {
          "$ref": "#/definitions/operationContract"
        },
        "input_message_id": {
          "type": "integer",
          "minimum": 1
        },
        "output_message_id": {
          "type": "integer",
          "minimum": 1
        },
        "output_rate_hz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "inputs": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/definitions/endpoint"
          }
        },
        "observes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          }
        },
        "output": {
          "$ref": "#/definitions/endpoint"
        },
        "service": {
          "$ref": "#/definitions/endpoint"
        },
        "policy": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/policyValue"
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "stream_out"}}},
          "then": {
            "required": ["output_message_id", "output_rate_hz"],
            "anyOf": [
              {"required": ["inputs"]},
              {"required": ["observes"]}
            ]
          }
        },
        {
          "if": {"properties": {"kind": {"const": "operation"}}},
          "then": {
            "required": [
              "operation_id",
              "operation_contract",
              "input_message_id",
              "output_message_id",
              "service",
              "policy"
            ],
            "properties": {
              "policy": {
                "type": "object",
                "required": ["timeout_ms"],
                "properties": {
                  "timeout_ms": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5000
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
