@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(XgcRoboticsInterfaces CONFIG REQUIRED)
include("${CMAKE_CURRENT_LIST_DIR}/XgcRosIoHelpersTargets.cmake")
set(XgcRosIoHelpers_Helpers_FOUND TRUE)

foreach(component IN LISTS XgcRosIoHelpers_FIND_COMPONENTS)
  if(component STREQUAL "Edge")
    find_dependency(XgcRuntimeSDK CONFIG REQUIRED)
    find_dependency(catkin REQUIRED COMPONENTS roscpp)
    if(NOT TARGET XgcRosIo::Edge)
      include("${CMAKE_CURRENT_LIST_DIR}/XgcRosIoEdgeTargets.cmake")
    endif()
    set(XgcRosIoHelpers_Edge_FOUND TRUE)
  elseif(NOT component STREQUAL "Helpers")
    set(XgcRosIoHelpers_${component}_FOUND FALSE)
  endif()
endforeach()
check_required_components(XgcRosIoHelpers)
