<?xml version="1.0"?>
<package format="2">
  <name>xgc_mocap_rotor_zenoh_forwarder</name>
  <version>0.5.0</version>
  <description>Read-only onboard MAVROS telemetry forwarder for the XGC2 Mocap Rotor Zenoh link.</description>
  <maintainer email="lxk@example.com">XGC</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>libzenohc-dev</build_depend>
  <build_depend>mavros_msgs</build_depend>
  <build_depend>nlohmann-json3-dev</build_depend>
  <build_depend>roscpp</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>mavros_msgs</exec_depend>
  <exec_depend>roscpp</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
</package>
