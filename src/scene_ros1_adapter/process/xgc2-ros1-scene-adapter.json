{
  "apiVersion": "xgc.execution.process/v1",
  "definitions": [
    {
      "id": "xgc2-ros1-scene-adapter",
      "version": "0.7.0",
      "label": "ROS1 Scene",
      "description": "Scene authoring and visualization for one Run on one ROS master, with explicit Gazebo, xsim and physical profiles. Started by the Run, ended with it.",
      "parameters": {
        "properties": {
          "socketPath": {
            "type": "string",
            "fixedOnly": true
          },
          "targetId": {
            "type": "string",
            "default": "local",
            "fixedOnly": true
          },
          "rosMasterUri": {
            "type": "string",
            "default": "http://127.0.0.1:11311"
          },
          "rosIp": {
            "type": "string",
            "default": "127.0.0.1"
          },
          "namespace": {
            "type": "string",
            "default": "/xgc_scene"
          },
          "sceneFile": {
            "type": "string"
          },
          "workingFile": {
            "type": "string",
            "default": ""
          },
          "generationParametersJson": {
            "type": "string",
            "default": "{}"
          },
          "saveDirectory": {
            "type": "string",
            "default": ""
          },
          "frozen": {
            "type": "boolean",
            "default": false
          },
          "profile": {
            "type": "string",
            "enum": [
              "gazebo",
              "xsim",
              "physical"
            ],
            "default": "gazebo"
          },
          "simulationServiceRefJson": {
            "type": "string",
            "default": ""
          },
          "lidarSocketPath": {
            "type": "string",
            "fixedOnly": true
          },
          "lidarFleetJson": {
            "type": "string",
            "default": ""
          },
          "lidarEnabled": {
            "type": "boolean",
            "default": true
          },
          "lidarDefaultsJson": {
            "type": "string",
            "default": "{}"
          }
        },
        "required": [
          "socketPath",
          "targetId",
          "rosMasterUri",
          "sceneFile",
          "lidarSocketPath"
        ]
      },
      "command": {
        "executable": "/opt/ros/noetic/lib/xgc_scene_ros1_adapter/xgc2_scene_adapter",
        "args": [
          "__name:=xgc2_scene_adapter",
          "__ns:=${namespace}",
          "__master:=${rosMasterUri}",
          "__ip:=${rosIp}",
          "_scene_file:=${sceneFile}",
          "_working_file:=${workingFile}",
          "_generation_parameters_json:=${generationParametersJson}",
          "_save_directory:=${saveDirectory}",
          "_target_id:=${targetId}",
          "_xrpc_socket:=${socketPath}",
          "_frozen:=${frozen}",
          "_profile:=${profile}",
          "_simulation_service_ref_json:=${simulationServiceRefJson}",
          "_lidar_xrpc_socket:=${lidarSocketPath}",
          "_lidar_fleet_json:=${lidarFleetJson}",
          "_lidar_enabled:=${lidarEnabled}",
          "_lidar_defaults_json:=${lidarDefaultsJson}"
        ]
      },
      "services": [
        {
          "service": "xgc2.scene.authoring",
          "api_version": "1",
          "profile": "http.v1",
          "endpointParameter": "socketPath"
        },
        {
          "service": "xgc2.sensor.lidar",
          "api_version": "1",
          "profile": "http.v1",
          "endpointParameter": "lidarSocketPath"
        }
      ],
      "readiness": {
        "kind": "describe",
        "startGraceMs": 15000,
        "timeoutMs": 30000
      },
      "stop": {
        "graceMs": 5000
      }
    }
  ]
}
