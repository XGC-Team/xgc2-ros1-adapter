if(NOT CORE_BUILD OR NOT CONSUMER_SOURCE)
  message(FATAL_ERROR "CORE_BUILD and CONSUMER_SOURCE are required")
endif()
set(stage "${CORE_BUILD}/installed-core-stage")
set(consumer "${CORE_BUILD}/installed-core-consumer")
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${CORE_BUILD}" --prefix "${stage}" --component scene_core RESULT_VARIABLE installed)
if(NOT installed EQUAL 0)
  message(FATAL_ERROR "Scene core component install failed: ${installed}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${CONSUMER_SOURCE}" -B "${consumer}"
  "-DCMAKE_PREFIX_PATH=${stage};${CMAKE_PREFIX_PATH}" RESULT_VARIABLE configured)
if(NOT configured EQUAL 0)
  message(FATAL_ERROR "Installed Scene core consumer configure failed: ${configured}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${consumer}" -j1 RESULT_VARIABLE built)
if(NOT built EQUAL 0)
  message(FATAL_ERROR "Installed Scene core consumer build failed: ${built}")
endif()
execute_process(COMMAND "${consumer}/consumer" WORKING_DIRECTORY "${consumer}" RESULT_VARIABLE ran)
if(NOT ran EQUAL 0)
  message(FATAL_ERROR "Installed Scene core consumer returned ${ran}")
endif()
