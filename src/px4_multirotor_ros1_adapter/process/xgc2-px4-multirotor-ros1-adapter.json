{
  "apiVersion": "xgc.execution.process/v1",
  "definitions": [
    {
      "id": "xgc2-px4-multirotor-ros1-adapter",
      "version": "0.7.0",
      "label": "PX4 multirotor ROS1 type server",
      "description": "Serves every PX4 multirotor of one Run on one ROS master: telemetry, VRPN forwarding, arm, mode, reboot and remote-control operations. Started by the Run, ended with it.",
      "parameters": {
        "properties": {
          "socketPath": {
            "type": "string",
            "fixedOnly": true
          },
          "runId": {
            "type": "string",
            "fixedOnly": true
          },
          "targetId": {
            "type": "string",
            "default": "local",
            "fixedOnly": true
          },
          "rosMasterUri": {
            "type": "string",
            "default": "http://127.0.0.1:11311"
          },
          "rosIp": {
            "type": "string",
            "default": ""
          }
        },
        "required": [
          "socketPath",
          "runId",
          "targetId",
          "rosMasterUri"
        ]
      },
      "command": {
        "executable": "/opt/ros/noetic/lib/xgc_px4_multirotor_ros1_adapter/xgc_px4_multirotor_ros1_adapter_node",
        "args": [
          "--socket-path",
          "${socketPath}",
          "--run-id",
          "${runId}",
          "--node-name",
          "xgc_px4_multirotor_${runId}",
          "--provider",
          "xgc2-px4-multirotor-ros1-adapter",
          "--target-id",
          "${targetId}",
          "--ros-master-uri",
          "${rosMasterUri}",
          "--ros-ip",
          "${rosIp}"
        ]
      },
      "services": [
        {
          "service": "xgc.robot.v1.RobotAdapterServerService",
          "profile": "grpc.v1",
          "endpointParameter": "socketPath",
          "api_version": "v1"
        }
      ],
      "readiness": {
        "kind": "describe",
        "startGraceMs": 15000,
        "timeoutMs": 30000
      },
      "stop": {
        "graceMs": 25000,
        "rpc": "Shutdown"
      }
    }
  ]
}
