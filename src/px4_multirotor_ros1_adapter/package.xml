<?xml version="1.0"?>
<package format="2">
  <name>xgc_px4_multirotor_ros1_adapter</name>
  <version>0.6.0</version>
  <description>PX4 multirotor ROS1 type server for XGC2.</description>

  <maintainer email="lxk@example.com">XGC</maintainer>
  <license>Unspecified</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>geometry_msgs</build_depend>
  <build_depend>libprotobuf-dev</build_depend>
  <build_depend>mavros_msgs</build_depend>
  <build_depend>python3-jsonschema</build_depend>
  <build_depend>python3-yaml</build_depend>
  <build_depend>roscpp</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>xgc2-protobuf-dev</build_depend>
  <build_depend>xgc_ros1_adapter_common</build_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>mavros_msgs</exec_depend>
  <exec_depend>roscpp</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>xgc_ros1_adapter_common</exec_depend>
</package>
