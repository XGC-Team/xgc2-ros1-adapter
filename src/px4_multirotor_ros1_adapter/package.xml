<?xml version="1.0"?>
<package format="2">
  <name>xgc_px4_multirotor_ros1_adapter</name>
  <version>0.5.0</version>
  <description>PX4 multirotor ROS1 service for XGC2.</description>

  <maintainer email="lxk@example.com">XGC</maintainer>
  <license>Unspecified</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>geometry_msgs</build_depend>
  <build_depend version_gte="1.16">libgrpc++-dev</build_depend>
  <build_depend>libxgc2-xrpc-grpc-dev</build_depend>
  <build_depend>libc-ares-dev</build_depend>
  <build_depend>protobuf-compiler-grpc</build_depend>
  <build_depend>mavros_msgs</build_depend>
  <build_depend>python3-jsonschema</build_depend>
  <build_depend>python3-yaml</build_depend>
  <build_depend>roscpp</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>xgc2-protobuf-dev</build_depend>

  <build_export_depend>mavros_msgs</build_export_depend>
  <build_export_depend>roscpp</build_export_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>libgrpc++1</exec_depend>
  <exec_depend>libxgc2-xrpc-grpc1</exec_depend>
  <exec_depend>libc-ares2</exec_depend>
  <exec_depend>mavros_msgs</exec_depend>
  <exec_depend>roscpp</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
</package>
