{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xgc.ros1.tools.v2.PublishResult",
  "type": "object",
  "properties": {
    "event": {"const": "published"},
    "topic": {"type": "string"},
    "messageType": {"type": "string"},
    "serializedBytes": {"type": "integer", "minimum": 0},
    "publishedCount": {"type": "integer", "minimum": 1},
    "subscriberCount": {"type": "integer", "minimum": 0}
  },
  "required": ["event", "topic", "messageType", "serializedBytes", "publishedCount", "subscriberCount"],
  "additionalProperties": false
}
