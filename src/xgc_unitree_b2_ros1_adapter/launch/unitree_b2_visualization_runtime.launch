<launch>
  <!--
    Session-supervised B2 visualization runtime. The Adapter remains the only
    wire decoder; this process only materializes its standard /joint_states as
    TF using the APT-installed, immutable visual description.
  -->
  <arg name="description_file"
       default="$(find b2arx_description)/urdf/b2arx_visual.urdf" />
  <arg name="publish_frequency" default="30.0" />

  <param name="robot_description" textfile="$(arg description_file)" />
  <node pkg="robot_state_publisher"
        type="robot_state_publisher"
        name="xgc2_b2_robot_state_publisher"
        output="screen">
    <param name="publish_frequency" value="$(arg publish_frequency)" />
  </node>
</launch>
