{
  "apiVersion": "xgc.execution.process/v1",
  "definitions": [
    {
      "id": "xgc2-scout-mini-ros1-adapter",
      "version": "0.7.0",
      "label": "Scout Mini ROS1 type server",
      "description": "Serves every Scout Mini of one Run on one ROS master: VRPN, IMU, power and chassis telemetry and discrete motion control. Started by the Run, ended with it.",
      "parameters": {
        "properties": {
          "socketPath": {
            "type": "string",
            "fixedOnly": true
          },
          "runId": {
            "type": "string",
            "fixedOnly": true
          },
          "targetId": {
            "type": "string",
            "default": "local",
            "fixedOnly": true
          },
          "rosMasterUri": {
            "type": "string",
            "default": "http://127.0.0.1:11311"
          },
          "rosIp": {
            "type": "string",
            "default": ""
          },
          "networkBootstrap": {
            "type": "string",
            "default": "",
            "fixedOnly": true,
            "sensitive": true
          }
        },
        "required": [
          "socketPath",
          "runId",
          "targetId",
          "rosMasterUri"
        ]
      },
      "command": {
        "executable": "/opt/ros/noetic/lib/xgc_ugv_ros1_adapter/xgc_ugv_ros1_adapter_node",
        "args": [
          "--socket-path",
          "${socketPath}",
          "--run-id",
          "${runId}",
          "--node-name",
          "xgc_scout_mini_${runId}",
          "--provider",
          "xgc2-scout-mini-ros1-adapter",
          "--target-id",
          "${targetId}",
          "--ros-master-uri",
          "${rosMasterUri}",
          "--ros-ip",
          "${rosIp}",
          "--network-bootstrap",
          "${networkBootstrap}"
        ]
      },
      "services": [
        {
          "service": "xgc.robot.v1.RobotAdapterServerService",
          "profile": "grpc.v1",
          "endpointParameter": "socketPath",
          "api_version": "v1",
          "network": {
            "bootstrapParameter": "networkBootstrap",
            "hostParameter": "rosIp",
            "port": 48102
          }
        }
      ],
      "readiness": {
        "kind": "describe",
        "startGraceMs": 15000,
        "timeoutMs": 30000
      },
      "stop": {
        "graceMs": 25000,
        "rpc": "Shutdown"
      }
    }
  ]
}
