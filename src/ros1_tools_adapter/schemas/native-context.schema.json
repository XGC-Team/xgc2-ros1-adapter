{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xgc.ros1.tools.v1.NativeContext",
  "type": "object",
  "properties": {
    "rosMasterUri": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^http://(?:[A-Za-z0-9._~-]+|\\[[0-9A-Fa-f:]+\\]):(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])/?$"
    },
    "rosIp": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^(?:$|[0-9A-Fa-f:.]+)$"
    },
    "rosHostname": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^(?:$|[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?\\.?)$"
    }
  },
  "required": ["rosMasterUri", "rosIp", "rosHostname"],
  "not": {
    "properties": {
      "rosIp": {"minLength": 1},
      "rosHostname": {"minLength": 1}
    },
    "required": ["rosIp", "rosHostname"]
  },
  "additionalProperties": false
}
