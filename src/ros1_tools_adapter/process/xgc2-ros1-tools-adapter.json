{
  "apiVersion": "xgc.execution.process/v1",
  "definitions": [
    {
      "id": "xgc2-ros1-tools-adapter",
      "version": "0.7.0",
      "label": "ROS1 Tools",
      "description": "Typed ROS1 topic publishing and service calls over XRPC for one Run on one ROS master. Started by the Run, ended with it.",
      "parameters": {
        "properties": {
          "socketPath": {
            "type": "string",
            "fixedOnly": true
          },
          "runId": {
            "type": "string",
            "fixedOnly": true
          },
          "targetId": {
            "type": "string",
            "default": "local",
            "fixedOnly": true
          },
          "rosMasterUri": {
            "type": "string",
            "default": "http://127.0.0.1:11311"
          },
          "rosIp": {
            "type": "string",
            "default": "127.0.0.1"
          },
          "rosHostname": {
            "type": "string",
            "default": ""
          },
          "publishers": {
            "type": "json",
            "default": []
          }
        },
        "required": [
          "socketPath",
          "runId",
          "targetId",
          "rosMasterUri"
        ]
      },
      "command": {
        "executable": "/opt/ros/noetic/lib/xgc_ros1_tools_adapter/xgc_ros1_tools_adapter_node",
        "args": [
          "--socket-path",
          "${socketPath}",
          "--run-id",
          "${runId}",
          "--node-name",
          "xgc_ros1_tools_${runId}",
          "--target-id",
          "${targetId}",
          "--ros-master-uri",
          "${rosMasterUri}",
          "--ros-ip",
          "${rosIp}",
          "--ros-hostname",
          "${rosHostname}",
          "--publishers",
          "${publishers}"
        ]
      },
      "services": [
        {
          "service": "ros1.tools",
          "profile": "http.v1",
          "endpointParameter": "socketPath",
          "api_version": "1"
        }
      ],
      "readiness": {
        "kind": "describe",
        "startGraceMs": 15000,
        "timeoutMs": 30000
      },
      "stop": {
        "graceMs": 5000
      },
      "setupFiles": [
        "/opt/ros/noetic/setup.bash"
      ]
    }
  ]
}
