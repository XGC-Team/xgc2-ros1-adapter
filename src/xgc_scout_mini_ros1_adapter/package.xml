  <version>0.5.0</version>
  <description>Scout Mini ROS1 robot Adapter application for XGC2 Adapter Runtime.</description>

  <maintainer email="lxk@example.com">XGC</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>libxgc2-adapter-runtime-client-dev</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>python3-jsonschema</build_depend>
  <build_depend>python3-yaml</build_depend>
  <build_depend>roscpp</build_depend>
  <build_depend>scout_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>xgc2-protobuf-dev</build_depend>

  <exec_depend>libxgc2-adapter-runtime-client1</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>roscpp</exec_depend>
